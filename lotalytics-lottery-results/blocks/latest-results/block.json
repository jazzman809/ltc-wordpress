{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lotalytics/latest-results",
	"version": "0.2.0",
	"title": "Lottery results",
	"category": "widgets",
	"icon": "awards",
	"description": "The latest winning numbers of a lottery, with the next draw date.",
	"keywords": [ "lottery", "lotto", "results", "winning numbers", "powerball" ],
	"textdomain": "lotalytics-lottery-results",
	"attributes": {
		"game": { "type": "string", "default": "" },
		"draws": { "type": "integer", "default": 5 },
		"compact": { "type": "boolean", "default": false },
		"showTitle": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": { "text": true, "background": true, "link": true },
		"typography": { "fontSize": true },
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "lotalytics-results-editor",
	"style": "lotalytics-results"
}
